        app:layout_constraintBottom_toTopOf="@+id/btnOnboarding3Start"
        app:layout_constraintStart_toEndOf="@+id/viewOnboarding3Center"
        app:layout_constraintTop_toTopOf="@+id/lineOnboarding3" />

    <View
        android:id="@+id/viewOnboarding3Center"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:background="@drawable/circle_onboarding"
        app:layout_constraintBottom_toTopOf="@+id/btnOnboarding3Start"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/lineOnboarding3" />

    <View
        android:id="@+id/viewOnboarding3Left"
        android:layout_width="12dp"
        android:layout_height="12dp"
