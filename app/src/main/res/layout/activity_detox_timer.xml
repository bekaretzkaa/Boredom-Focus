<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D"
    android:padding="24dp"
    tools:context=".ui.DetoxTimerActivity">

    <View
        android:id="@+id/viewRedDot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:background="@drawable/circle_filled_red"
        android:layout_marginRight="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/tvDetox"
        app:layout_constraintEnd_toStartOf="@+id/tvDetox"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvDetox" />

    <TextView
        android:id="@+id/tvDetox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_medium"
        android:text="Detox"
        android:textAllCaps="true"
        android:textColor="#E24B4A"
        android:textSize="22sp"
        android:layout_marginLeft="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/viewRedDot"
        app:layout_constraintTop_toTopOf="parent" />

    <com.example.boredomfocus.ui.CircularProgressView
        android:id="@+id/progressViewDetoxTimer"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_marginTop="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvDetox" />

    <TextView
        android:id="@+id/tvDetoxTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_bold"
        android:text="08:24"
        android:textColor="@color/white"
        android:textSize="52sp"
        android:layout_marginTop="60dp"
        app:layout_constraintEnd_toEndOf="@+id/progressViewDetoxTimer"
        app:layout_constraintStart_toStartOf="@+id/progressViewDetoxTimer"
        app:layout_constraintTop_toTopOf="@+id/progressViewDetoxTimer" />

    <TextView
        android:id="@+id/tvDetoxTimer2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_medium"
        android:text="remaining"
        android:textSize="26sp"
        app:layout_constraintEnd_toEndOf="@+id/progressViewDetoxTimer"
        app:layout_constraintStart_toStartOf="@+id/progressViewDetoxTimer"
        app:layout_constraintTop_toBottomOf="@+id/tvDetoxTimer" />

</androidx.constraintlayout.widget.ConstraintLayout>