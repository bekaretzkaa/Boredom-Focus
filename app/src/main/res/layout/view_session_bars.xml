<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#0D0D0D">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/detoxBarContainer"
        android:layout_width="0dp"
        android:layout_height="6dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:background="@drawable/bg_progress_gray"
        app:layout_constraintBottom_toBottomOf="@+id/tvSessionDetoxWord"
        app:layout_constraintEnd_toStartOf="@+id/tvSessionDetoxWord"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvSessionDetoxWord">

        <View
            android:id="@+id/viewDetoxProgress"
            android:layout_width="0dp"
            app:layout_constraintWidth_percent="0.5"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:background="@drawable/bg_progress_red" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/tvSessionDetoxWord"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="10 мин"
        android:textColor="#E04A49"
        android:fontFamily="@font/inter_medium"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/focusBarContainer"
        android:layout_width="0dp"
        android:layout_height="6dp"
        android:background="@drawable/bg_progress_gray"
        app:layout_constraintBottom_toBottomOf="@+id/tvSessionFocusWord"
        app:layout_constraintEnd_toEndOf="@+id/detoxBarContainer"
        app:layout_constraintStart_toStartOf="@+id/detoxBarContainer"
        app:layout_constraintTop_toTopOf="@+id/tvSessionFocusWord">

        <View
            android:id="@+id/viewFocusProgress"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_progress_green"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.5" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/tvSessionFocusWord"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="30 мин"
        android:textColor="#639922"
        android:fontFamily="@font/inter_medium"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvSessionDetoxWord" />

</androidx.constraintlayout.widget.ConstraintLayout>