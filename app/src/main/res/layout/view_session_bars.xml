<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#0D0D0D">

    <TextView
        android:id="@+id/tvTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_medium"
        android:text="09:41"
        android:textColor="#333333"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/viewDetox"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="18dp"
        android:background="@drawable/red_detox_square"
        app:layout_constraintStart_toEndOf="@id/tvTime"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/detoxBarContainer"
        android:layout_width="180dp"
        android:layout_height="6dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_progress_gray"
        app:layout_constraintTop_toTopOf="@id/viewDetox"
        app:layout_constraintBottom_toBottomOf="@id/viewDetox"
        app:layout_constraintStart_toEndOf="@id/viewDetox">

        <View
            android:id="@+id/viewDetoxProgress"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_progress_red"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.5" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/tvSessionDetoxWord"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_medium"
        android:text="10 мин"
        android:textColor="@color/red_basic"
        android:textSize="16sp"
        android:layout_marginEnd="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/detoxBarContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/detoxBarContainer" />

    <View
        android:id="@+id/viewFocus"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="18dp"
        android:background="@drawable/green_focus_square"
        app:layout_constraintStart_toEndOf="@id/tvTime"
        app:layout_constraintTop_toBottomOf="@id/viewDetox" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/focusBarContainer"
        android:layout_width="180dp"
        android:layout_height="6dp"
        android:background="@drawable/bg_progress_gray"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toTopOf="@id/viewFocus"
        app:layout_constraintBottom_toBottomOf="@id/viewFocus"
        app:layout_constraintStart_toEndOf="@id/viewFocus">

        <View
            android:id="@+id/viewFocusProgress"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_progress_green"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.5" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/tvSessionFocusWord"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_medium"
        android:text="14:32"
        android:textColor="@color/green_basic"
        android:textSize="18sp"
        android:layout_marginEnd="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/focusBarContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/focusBarContainer" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/green_bg"
        app:cardCornerRadius="8dp"
        app:strokeColor="#0D0D0D"
        app:layout_constraintBottom_toBottomOf="@+id/focusBarContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/focusBarContainer" >

        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.7"
            android:fontFamily="@font/inter_medium"
            android:paddingHorizontal="12dp"
            android:text="фокус"
            android:textColor="@color/green_basic"
            android:textSize="14sp" />
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>