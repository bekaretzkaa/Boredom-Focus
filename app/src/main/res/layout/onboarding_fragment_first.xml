<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/onboarding1"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D"
    android:padding="24dp">

    <View
        android:id="@+id/viewSquare"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:background="@drawable/square"
        app:layout_constraintBottom_toTopOf="@+id/tvOnboarding11"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvOnboarding11"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_bold"
        android:text="Твой мозг зависим.\nЭто меняется сейчас."
        android:textAllCaps="true"
        android:textColor="@color/white"
        android:textSize="26sp"
        android:textAlignment="center"
        app:layout_constraintBottom_toTopOf="@+id/tvOnboarding12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/viewSquare" />

    <TextView
        android:id="@+id/tvOnboarding12"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_medium"
        android:text="Каждое уведомление — доза дофамина. Приложение поможет тебе научиться сидеть в тишине и не тянуться к телефону."
        android:textAlignment="center"
        android:textAllCaps="false"
        android:textColor="#888888"
        android:textSize="20sp"

        app:layout_constraintBottom_toTopOf="@+id/lineOnboarding1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvOnboarding11" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/lineOnboarding1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.78" />

