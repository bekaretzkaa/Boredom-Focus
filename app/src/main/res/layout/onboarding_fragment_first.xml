        app:layout_constraintBottom_toTopOf="@+id/btnOnboarding1GotIt"
        app:layout_constraintStart_toEndOf="@+id/viewOnboarding1Center"
        app:layout_constraintTop_toTopOf="@+id/lineOnboarding1" />
        -->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOnboarding1GotIt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#0D0D0D"
        android:fontFamily="@font/inter_bold"
        android:paddingVertical="16dp"
        android:text="Понятно"
        android:textColor="@color/white"
        android:textSize="24sp"
        app:cornerRadius="12dp"
        app:icon="@drawable/ic_arrow_right"
        app:iconGravity="textEnd"
        app:iconSize="28dp"
        app:iconTint="@color/white"
        app:layout_constraintBottom_toTopOf="@+id/btnOnboarding1Skip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/lineOnboarding1"
        app:strokeColor="#888888"
        app:strokeWidth="1dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOnboarding1Skip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#0D0D0D"
        android:fontFamily="@font/inter_bold"
        android:paddingVertical="16dp"
        android:text="Пропустить"
        android:textColor="@color/white"
        android:textSize="24sp"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnOnboarding1GotIt"
        app:strokeColor="#888888"
        app:strokeWidth="1dp" />

