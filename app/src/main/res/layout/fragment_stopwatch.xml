<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="#0D0D0D"
    tools:context=".feature.focussession.fragments.StopwatchFragment">

    <TextView
        android:id="@+id/tvStatusBadge"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/inter_medium"
        android:gravity="center"
        android:maxLines="1"
        android:text="✓ рекорд недели"
        android:textAllCaps="true"
        android:textColor="@color/green_basic"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvFocusTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="05:47"
        android:textSize="80sp"
        android:fontFamily="@font/inter_medium"
        android:textColor="@color/green_basic"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvStatusBadge" />

    <TextView
        android:id="@+id/tvFocusComparison"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_medium"
        android:text="+00:16 от прошлой сессии ↑"
        android:textColor="@color/green_basic"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvFocusTime" />

    <LinearLayout
        android:id="@+id/llTargets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingVertical="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvFocusComparison">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <View
                android:id="@+id/dotSession"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:background="@drawable/circle_filled_green"/>
            
            <TextView
                android:id="@+id/tvSession"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="сессия"
                android:textColor="@color/green_basic"
                android:textSize="15sp"/>

        </LinearLayout>
        
        <View
            android:id="@+id/lineSession"
            android:layout_width="0dp"
            android:layout_height="1.5dp"
            android:layout_weight="1"
            android:layout_marginBottom="10dp"
            android:background="@color/green_basic"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <View
                android:id="@+id/dotWeek"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:background="@drawable/circle_empty"/>

            <TextView
                android:id="@+id/tvWeek"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="неделя"
                android:textColor="@color/white"
                android:textSize="15sp"/>

        </LinearLayout>

        <View
            android:id="@+id/lineWeek"
            android:layout_width="0dp"
            android:layout_height="1.5dp"
            android:layout_weight="1"
            android:layout_marginBottom="10dp"
            android:background="@color/gray_focus"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <View
                android:id="@+id/dotMonth"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:background="@drawable/circle_filled_gray"/>

            <TextView
                android:id="@+id/tvMonth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="месяц"
                android:textColor="@color/gray_focus"
                android:textSize="15sp"/>

        </LinearLayout>

        <View
            android:id="@+id/lineMonth"
            android:layout_width="0dp"
            android:layout_height="1.5dp"
            android:layout_weight="1"
            android:layout_marginBottom="10dp"
            android:background="@color/gray_focus"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <View
                android:id="@+id/dotAllTime"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:background="@drawable/circle_filled_gray"/>

            <TextView
                android:id="@+id/tvAllTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="рекорд"
                android:textColor="@color/gray_focus"
                android:textSize="15sp"/>

        </LinearLayout>

    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/explanationCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        app:cardBackgroundColor="#141414"
        app:cardCornerRadius="16dp"
        app:strokeColor="#242424"
        app:strokeWidth="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/llTargets">

        <TextView
            android:id="@+id/tvExplanation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_medium"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:text="Первая сессия недели — недельный рекорд появится после завершения"
            android:textColor="@color/gray_basic"
            android:textSize="13sp" />

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvFocusTarget"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:ellipsize="end"
        android:fontFamily="@font/inter_medium"
        android:maxLines="1"
        android:text="цель — рекорд недели"
        android:textColor="@color/gray_basic"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@+id/tvFocusTargetTime"
        app:layout_constraintEnd_toStartOf="@+id/tvFocusTargetTime"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvFocusTargetTime" />

    <TextView
        android:id="@+id/tvFocusTargetTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_medium"
        android:gravity="end"
        android:minWidth="58dp"
        android:text="09:07"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/explanationCard" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/progressContainer"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="@color/gray_focus"
        app:strokeWidth="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvFocusTargetTime">

        <View
            android:id="@+id/progressFill"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleX="0"
            android:background="@color/green_basic" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/flashCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="24dp"
        app:strokeWidth="2dp"
        app:strokeColor="@color/green_basic"
        app:cardBackgroundColor="#0F1A0F"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/progressContainer"
        android:visibility="gone">
        
        <LinearLayout
            android:id="@+id/flashContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="16dp"
            android:paddingHorizontal="22dp">
            
            <TextView
                android:id="@+id/flashIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="28sp"
                android:text="🔥"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="16dp">

                <TextView
                    android:id="@+id/tvFlash1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_medium"
                    android:text="Лучше чем в прошлый раз!"
                    android:textColor="@color/green_basic"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tvFlash2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_medium"
                    android:text="Теперь цель — рекорд недели"
                    android:textColor="@color/gray_basic"
                    android:textSize="15sp" />
            </LinearLayout>
            
        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/zoneCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#0F1A0F"
        app:cardCornerRadius="24dp"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/flashCard"
        app:strokeColor="@color/green_basic"
        app:strokeWidth="2dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvZone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="@font/inter_medium"
            android:text="• зона некомфорта"
            android:textAllCaps="true"
            android:textColor="@color/green_basic"
            android:textSize="14sp"
            android:gravity="center"
            android:paddingVertical="4dp"
            android:paddingHorizontal="16dp"/>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStopFocus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#141414"
        android:fontFamily="@font/inter_bold"
        android:padding="20dp"
        android:text="Остановить фокус"
        android:textColor="#666666"
        android:textSize="20sp"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="#333333"
        app:strokeWidth="2dp" />

    <com.example.boredomfocus.feature.focussession.views.ConfettiView
        android:id="@+id/confettiView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="false"
        android:focusable="false"
        android:elevation="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>